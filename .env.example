# ====================================================================
# SÛRCHECK AI — VARIABLES D'ENVIRONNEMENT PRODUCTION
# ====================================================================
# Ce fichier contient TOUTES les variables nécessaires au déploiement.
# Documentation complète dans DEPLOYMENT.md, RAILWAY_DEPLOYMENT.md et VERCEL_DEPLOYMENT.md
#
# ⚠️  SÉCURITÉ : NE JAMAIS COMMITTER CE FICHIER AVEC DES SECRETS RÉELS
#     Les secrets doivent être configurés uniquement dans les interfaces Railway/Vercel
#     Ce fichier .env.example sert de template et de documentation
# ====================================================================

# ====================================================================
# SECTION 1 — BACKEND RAILWAY (FastAPI)
# ====================================================================
# Configuration à ajouter dans : Railway → Service → Variables → RAW Editor
# Guide complet : RAILWAY_DEPLOYMENT.md
# ====================================================================

# ── Environnement d'exécution ─────────────────────────────────────────

# Environnement de déploiement (production, staging, development)
# Désactive Swagger/Redoc en production pour la sécurité
ENVIRONMENT=production

# Version de l'API (affiché dans /health et logs)
VERSION=v1.0.0

# Nom du projet (logs et monitoring)
PROJECT_NAME=SûrCheck AI API

# Préfixe de toutes les routes API (/api/v1/*)
API_PREFIX=/api/v1

# ── CORS & URLs ───────────────────────────────────────────────────────

# Origines CORS autorisées (format JSON strict)
# ⚠️ Mettre l'URL Vercel réelle après déploiement
# Exemple : ["https://sur-check.vercel.app","https://surcheck.bj"]
CORS_ORIGINS=["https://surcheck-ai.vercel.app","https://surcheck.bj"]

# URL publique du frontend (utilisée pour les redirections post-paiement Chariow)
# ⚠️ Doit correspondre à l'URL Vercel de production
APP_URL=https://surcheck-ai.vercel.app

# ── Supabase (Base de données & Authentification) ─────────────────────

# URL du projet Supabase (publique)
# Récupérer dans : Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://lhxbzflectkuysaklvji.supabase.co

# Clé anonyme Supabase (publique, utilisée côté client)
# Récupérer dans : Supabase Dashboard → Settings → API → anon / public
SUPABASE_ANON_KEY=sb_publishable_59E__jIIWr3HRG3XkV4Rcg_U0KZdYNH

# 🔒 CLE SECRETE - Clé service_role Supabase (accès administrateur complet)
# Récupérer dans : Supabase Dashboard → Settings → API → service_role (cliquer sur "Reveal")
# ⚠️ NE JAMAIS exposer cette clé publiquement ou côté client
# ⚠️ Donne un accès complet à la base de données (lecture, écriture, suppression)
SUPABASE_SERVICE_ROLE_KEY=<<REMPLACER_PAR_VOTRE_CLE_SERVICE_ROLE>>

# ── Base de données PostgreSQL ────────────────────────────────────────

# Connection string PostgreSQL via Transaction Pooler (port 6543)
# Récupérer dans : Supabase Dashboard → Settings → Database → Connection Pooling
# Format : postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:6543/postgres
# ⚠️ Le mot de passe contient des caractères encodés en URL (%2F, %25, etc.) - NE PAS DECODER
# ⚠️ Utiliser le port 6543 (Transaction Pooler) et NON le port 5432 (Session Mode)
DATABASE_URL=postgresql://postgres.lhxbzflectkuysaklvji:<<VOTRE_MOT_DE_PASSE_DB>>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ── Sécurité & JWT (JSON Web Tokens) ──────────────────────────────────

# 🔒 CLE SECRETE - Secret pour signer les JWT (tokens d'authentification)
# Générer avec : openssl rand -hex 32 (Linux/Mac) ou https://randomkeygen.com (Fort Knox Passwords)
# ⚠️ Minimum 64 caractères pour une sécurité optimale
# ⚠️ NE JAMAIS changer cette clé après la mise en production (invalide tous les tokens)
JWT_SECRET_KEY=<<GENERER_CLE_JWT_ALEATOIRE_64_CHARS>>

# Algorithme de signature JWT (HS256 = HMAC-SHA256)
# Ne pas modifier sauf si vous savez ce que vous faites
JWT_ALGORITHM=HS256

# Durée de validité des tokens d'accès en minutes
# 1440 minutes = 24 heures (équilibre entre sécurité et UX)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Salt pour le hachage des numéros de téléphone (conformité APDP)
# ⚠️ NE JAMAIS changer après la mise en production (rend les numéros hachés incomparables)
# Les numéros sont hachés avec SHA256 avant stockage pour protéger la vie privée
PHONE_HASH_SALT=surcheck_bj_secure_salt_2026_antigravity_trust

# ── Paiements Mobile Money (Provider sélectionné) ─────────────────────

# Provider de paiement actif : chariow | saspay
# Permet de basculer entre les deux fournisseurs sans modifier le code
# Valeurs acceptées : chariow, saspay
# Par défaut : chariow (rétrocompatibilité)
PAYMENT_PROVIDER=chariow

# ── Chariow API (Provider principal actuel) ───────────────────────────

# Clé API Chariow (sandbox ou production)
# Récupérer dans : app.chariow.com → Settings → API Keys
# Format : sk_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHARIOW_API_KEY=sk_o0xs5yj1_6ed3b1413ce916e7835c6d884b6548f7

# URL de base de l'API Chariow (v1 stable)
# Production : https://api.chariow.com/v1
# Sandbox : https://sandbox-api.chariow.com/v1 (pour tests)
CHARIOW_BASE_URL=https://api.chariow.com/v1

# 🔒 Secret du webhook Chariow (vérification de signature des events)
# Récupérer dans : app.chariow.com → Pulses (Webhooks) → Votre webhook → Secret
# Format : whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ⚠️ Utilisé pour valider que les notifications viennent bien de Chariow
CHARIOW_WEBHOOK_SECRET=whsec_GmbUMyji4cdf07Hv1pRGlBOUquHiZ4ibfAXW38xz

# ── Identifiants produits Chariow ─────────────────────────────────────

# ID des produits créés sur le tableau de bord Chariow
# À créer dans : app.chariow.com → Products → New Product
# Format : prd_xxxxxxxx

# Pack 1 crédit - 600 FCFA (analyse unique)
CHARIOW_PRODUCT_PACK_1=prd_ltwqdexr

# Pack 5 crédits - 1500 FCFA (300 F/analyse)
CHARIOW_PRODUCT_PACK_5=prd_c7ju43kh

# Pack 10 crédits - 2500 FCFA (250 F/analyse) - Pack recommandé
CHARIOW_PRODUCT_PACK_10=prd_060n1o9q

# Pack 25 crédits - 5000 FCFA (200 F/analyse) - Meilleur rapport qualité/prix
CHARIOW_PRODUCT_PACK_25=prd_9v1hutfu

# ── SasPay API (Provider alternatif - Softpay Mobile Money) ──────────

# 🔒 CLE SECRETE - Clé API SasPay (sandbox ou production)
# Récupérer dans : application.saspay.me → Dashboard → Développeur → API Keys
# Format : sk_test_xxxxx (sandbox) ou sk_live_xxxxx (production)
# ⚠️ Utiliser sk_test_* en développement pour ne pas utiliser d'argent réel
# ⚠️ Passer à sk_live_* uniquement après validation complète en sandbox
SASPAY_API_KEY=<<REMPLACER_PAR_VOTRE_CLE_SASPAY>>

# URL de base de l'API SasPay (v1 stable)
# Production & Sandbox : https://api.saspay.me/api/v1 (même URL pour les deux modes)
# Le mode (test/live) est déterminé par la clé API (sk_test_* vs sk_live_*)
SASPAY_BASE_URL=https://api.saspay.me/api/v1

# 🔒 Secret du webhook SasPay (vérification de signature des events)
# Récupérer dans : application.saspay.me → Dashboard → Webhooks → Votre webhook → Secret
# ⚠️ Format exact à documenter après configuration du premier webhook
# ⚠️ Utilisé pour valider que les notifications viennent bien de SasPay
SASPAY_WEBHOOK_SECRET=<<REMPLACER_PAR_VOTRE_SECRET_WEBHOOK_SASPAY>>

# ── Notes spécifiques SasPay ──────────────────────────────────────────

# 📌 DIFFÉRENCES CLÉS vs Chariow :
#
# 1. PAS de product_id : SasPay nécessite le montant explicite à chaque appel
#    Les montants sont définis dans config.py (CREDIT_PACK_*_FCFA)
#
# 2. Détection réseau automatique : Le système détecte MTN/Moov depuis le numéro
#    Préfixes Bénin - MTN : 40-49, 50-59, 60-69, 90-99 | Moov : 01-03, 80-89
#
# 3. checkout_url dynamique : Vide pour MTN/Moov (push USSD direct)
#    Non-vide pour Wave/Orange/Djamo (redirection obligatoire)
#
# 4. Idempotence obligatoire : Header Idempotency-Key automatique (évite doublons)
#
# 5. Webhooks à documenter : Mécanisme de signature à valider en sandbox
#    Implémentation temporaire basée sur HMAC-SHA256
#
# 📚 Documentation : https://docs.saspay.me (à consulter pour détails avancés)
# 🧪 Sandbox : Utiliser sk_test_* pour tester sans argent réel
# ✅ Migration : Voir MIGRATION_SASPAY.md pour guide complet

# ── Tarification des packs de crédits ────────────────────────────────

# Tarifs en Francs CFA (FCFA)
# ⚠️ Ces valeurs DOIVENT correspondre aux prix des produits Chariow
# ⚠️ Minimum Chariow : 565 FCFA par transaction

# Pack 1 crédit (analyse unique)
CREDIT_PACK_1_FCFA=600

# Pack 5 crédits (économie de 20% vs pack 1)
CREDIT_PACK_5_FCFA=1500

# Pack 10 crédits (économie de 33% vs pack 1) - Le plus populaire
CREDIT_PACK_10_FCFA=2500

# Pack 25 crédits (économie de 50% vs pack 1) - Meilleur rapport
CREDIT_PACK_25_FCFA=5000

# ====================================================================
# SECTION 2 — FRONTEND VERCEL (Next.js)
# ====================================================================
# Configuration à ajouter dans : Vercel → Project → Settings → Environment Variables
# Guide complet : VERCEL_DEPLOYMENT.md
# ⚠️ Ajouter chaque variable individuellement dans l'interface Vercel
# ⚠️ Cocher "Production", "Preview" ET "Development" pour chaque variable
# ====================================================================

# ── URL du backend API ────────────────────────────────────────────────

# URL interne utilisée par le rewrite Next.js (côté serveur uniquement)
# ⚠️ REMPLACER par l'URL Railway réelle après déploiement du backend
# Exemple : https://surcheck-production-abc123.up.railway.app
# Si Railway pas encore déployé, mettre temporairement : http://localhost:8000
INTERNAL_API_URL=https://<<VOTRE_SERVICE>>.up.railway.app

# ── Variables publiques (exposées au navigateur) ──────────────────────

# 🌐 PUBLIC - Base URL de l'API côté client
# Utilisée par les fetch() dans le navigateur
# Valeur : /api/v1 (rewrite Next.js vers INTERNAL_API_URL)
NEXT_PUBLIC_API_URL=/api/v1

# 🌐 PUBLIC - Nom de l'application (affiché dans l'interface)
NEXT_PUBLIC_APP_NAME=SûrCheck AI

# 🌐 PUBLIC - URL du projet Supabase
# Même valeur que SUPABASE_URL dans la section Railway
NEXT_PUBLIC_SUPABASE_URL=https://lhxbzflectkuysaklvji.supabase.co

# 🌐 PUBLIC - Clé anonyme Supabase (sûre pour le client)
# Même valeur que SUPABASE_ANON_KEY dans la section Railway
# ⚠️ Cette clé est publique et limitée par les RLS (Row Level Security) de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_59E__jIIWr3HRG3XkV4Rcg_U0KZdYNH

# ====================================================================
# NOTES IMPORTANTES
# ====================================================================

# 🔒 SÉCURITÉ
# -----------
# - Les variables marquées "🔒 CLE SECRETE" ne doivent JAMAIS être exposées publiquement
# - Les variables marquées "🌐 PUBLIC" sont exposées au navigateur (normales)
# - Ne jamais committer de fichiers .env avec des secrets réels
# - Utiliser .env.example comme template uniquement

# 📦 DÉPLOIEMENT
# --------------
# 1. Backend Railway : Copier SECTION 1 dans Railway → Variables → RAW Editor
# 2. Frontend Vercel : Ajouter SECTION 2 dans Vercel → Environment Variables (une par une)
# 3. Remplacer les valeurs marquées <<REMPLACER>>
# 4. Suivre les guides : RAILWAY_DEPLOYMENT.md et VERCEL_DEPLOYMENT.md

# 🔄 ORDRE DE DÉPLOIEMENT RECOMMANDÉ
# -----------------------------------
# 1. Corriger .gitignore (ne doit pas ignorer lib/)
# 2. Commiter et pusher les fichiers lib/ sur GitHub
# 3. Déployer le backend sur Railway (récupérer l'URL)
# 4. Configurer Vercel avec l'URL Railway dans INTERNAL_API_URL
# 5. Déployer le frontend sur Vercel
# 6. Mettre à jour CORS_ORIGINS sur Railway avec l'URL Vercel
# 7. Configurer le webhook Chariow avec l'URL Railway

# 🧪 TESTS DE VALIDATION
# ----------------------
# Backend Railway : curl https://[URL_RAILWAY]/health
# Frontend Vercel : curl https://[URL_VERCEL]
# API Packs : curl https://[URL_RAILWAY]/api/v1/payment/packs
# Webhook Chariow : Tester dans app.chariow.com → Pulses

# 📚 DOCUMENTATION
# ----------------
# - CHANGELOG.md : Historique des modifications
# - RAILWAY_DEPLOYMENT.md : Guide détaillé backend Railway
# - VERCEL_DEPLOYMENT.md : Guide détaillé frontend Vercel
# - DEPLOYMENT.md : Vue d'ensemble architecture et déploiement

